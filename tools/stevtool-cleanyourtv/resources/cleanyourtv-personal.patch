+    @SuppressWarnings("deprecation")
+    private void connectToWifi(WifiManager wm, String ssid, String password, String capabilities) {
+        try {
+            WifiConfiguration wc = new WifiConfiguration();
+            wc.SSID = "\"" + ssid + "\"";
+            if (password == null || password.isEmpty()) {
+                wc.allowedKeyManagement.set(WifiConfiguration.KeyMgmt.NONE);
+            } else if (capabilities != null && capabilities.contains("WEP")) {
+                wc.wepKeys[0] = "\"" + password + "\"";
+                wc.wepTxKeyIndex = 0;
+                wc.allowedKeyManagement.set(WifiConfiguration.KeyMgmt.NONE);
+                wc.allowedGroupCiphers.set(WifiConfiguration.GroupCipher.WEP40);
+            } else {
+                wc.preSharedKey = "\"" + password + "\"";
+            }
+            int netId = wm.addNetwork(wc);
+            if (netId != -1 && wm.enableNetwork(netId, true)) {
+                wm.reconnect();
+                Toast.makeText(this, getString(R.string.wifi_connecting, ssid), Toast.LENGTH_SHORT).show();
+                return;
+            }
+        } catch (Exception ignored) {}
+
+        Toast.makeText(this, R.string.wifi_failed, Toast.LENGTH_SHORT).show();
+        open(systemIntent(Settings.ACTION_WIFI_SETTINGS));
+    }

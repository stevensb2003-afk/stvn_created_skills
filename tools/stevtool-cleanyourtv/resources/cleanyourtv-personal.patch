+    /** Renders a 16:9 tile banner with a gradient background, centered icon and bold readable title text. */
+    private Drawable makeLabeledBanner(int startColor, int endColor, int iconRes, String title) {
+        int w = 360, h = 202;
+        Bitmap bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bmp);
+        Paint bg = new Paint(Paint.ANTI_ALIAS_FLAG);
+        bg.setShader(new LinearGradient(0, 0, w, h, startColor, endColor, Shader.TileMode.CLAMP));
+        canvas.drawRect(0, 0, w, h, bg);
+
+        Drawable icon = ctx.getDrawable(iconRes);
+        if (icon != null) {
+            Drawable d = icon.getConstantState() != null ? icon.getConstantState().newDrawable().mutate() : icon.mutate();
+            d.setTint(0xFFFFFFFF);
+            int iconSize = 68;
+            int left = (w - iconSize) / 2;
+            int top = 34;
+            d.setBounds(left, top, left + iconSize, top + iconSize);
+            d.draw(canvas);
+        }
+
+        Paint textPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        textPaint.setColor(0xFFFFFFFF);
+        textPaint.setTextAlign(Paint.Align.CENTER);
+        float textSize = 34f;
+        textPaint.setTextSize(textSize);
+        try {
+            Typeface tf = ctx.getResources().getFont(R.font.outfit_medium);
+            if (tf != null) textPaint.setTypeface(tf);
+        } catch (Exception ignored) {
+            textPaint.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+        }
+        while (textSize > 20f && textPaint.measureText(title) > w - 32f) {
+            textSize -= 1.5f;
+            textPaint.setTextSize(textSize);
+        }
+        canvas.drawText(title, w / 2f, 158f, textPaint);
+        return new BitmapDrawable(ctx.getResources(), bmp);
+    }

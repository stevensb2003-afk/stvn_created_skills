+    private void toggleBluetoothDeviceConnection(BluetoothDevice dev, String name, boolean currentlyConnected) {
+        Toast.makeText(this, getString(currentlyConnected ? R.string.bt_disconnecting : R.string.bt_connecting, name),
+                Toast.LENGTH_SHORT).show();
+        String methodName = currentlyConnected ? "disconnect" : "connect";
+        try {
+            dev.getClass().getMethod(methodName).invoke(dev);
+        } catch (Exception ignored) {}
+
+        BluetoothManager bm = (BluetoothManager) getSystemService(Context.BLUETOOTH_SERVICE);
+        BluetoothAdapter adapterBt = bm != null ? bm.getAdapter() : BluetoothAdapter.getDefaultAdapter();
+        if (adapterBt == null) return;
+        for (int profile : new int[]{BluetoothProfile.A2DP, BluetoothProfile.HEADSET}) {
+            try {
+                adapterBt.getProfileProxy(this, new BluetoothProfile.ServiceListener() {
+                    @Override
+                    public void onServiceConnected(int p, BluetoothProfile proxy) {
+                        try {
+                            proxy.getClass().getMethod(methodName, BluetoothDevice.class).invoke(proxy, dev);
+                        } catch (Exception ignored) {
+                        } finally {
+                            adapterBt.closeProfileProxy(p, proxy);
+                        }
+                    }
+
+                    @Override
+                    public void onServiceDisconnected(int p) {}
+                }, profile);
+            } catch (Exception ignored) {}
+        }
+    }
+
+    private boolean isBluetoothDeviceConnected(BluetoothDevice dev) {
+        try {
+            Object res = dev.getClass().getMethod("isConnected").invoke(dev);
+            return res instanceof Boolean && (Boolean) res;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    private int readBluetoothBattery(BluetoothDevice dev) {
+        Integer cached = dev.getAddress() != null ? btBatteryByAddr.get(dev.getAddress()) : null;
+        if (cached != null && cached >= 0) return cached;
+        try {
+            Object res = dev.getClass().getMethod("getBatteryLevel").invoke(dev);
+            if (res instanceof Integer && (Integer) res >= 0) return (Integer) res;
+        } catch (Exception ignored) {}
+        return -1;
+    }
 }

+    private boolean isIgnoredTvOrRemoteDevice(BluetoothDevice dev, String adapterName) {
+        String name = dev.getName();
+        if (name == null || name.trim().isEmpty()) return true;
+        if (adapterName != null && name.equalsIgnoreCase(adapterName)) return true;
+        String lower = name.toLowerCase(Locale.ROOT);
+        if (lower.endsWith(" rc") || lower.contains("remote") || lower.contains("tv remote")) {
+            return true;
+        }
+        try {
+            android.bluetooth.BluetoothClass bc = dev.getBluetoothClass();
+            if (bc != null) {
+                int major = bc.getMajorDeviceClass();
+                int devClass = bc.getDeviceClass();
+                // Ignore HID remotes/keyboards/mice unless it's a gamepad/joystick.
+                if (major == android.bluetooth.BluetoothClass.Device.Major.PERIPHERAL
+                        && devClass != 0x0508 && devClass != 0x0504) {
+                    return true;
+                }
+            }
+        } catch (SecurityException ignored) {}
+        return false;
+    }

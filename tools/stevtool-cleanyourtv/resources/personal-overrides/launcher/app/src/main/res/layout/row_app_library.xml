<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/btnLibrary"
        style="@style/TopButton"
        android:layout_marginEnd="14dp"
        android:text="@string/app_library"
        android:drawableStart="@drawable/ic_apps" />

    <TextView
        android:id="@+id/btnFooterEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@null"
        android:focusable="true"
        android:clickable="true"
        android:singleLine="true"
        android:fontFamily="@font/outfit_regular"
        android:textSize="13sp"
        android:letterSpacing="0.03"
        android:textColor="#80FFFFFF"
        android:text="@string/reorder" />

    <TextView
        android:id="@+id/btnFooterLauncherSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@null"
        android:focusable="true"
        android:clickable="true"
        android:singleLine="true"
        android:fontFamily="@font/outfit_regular"
        android:textSize="13sp"
        android:letterSpacing="0.03"
        android:textColor="#80FFFFFF"
        android:text="@string/launcher_settings" />
</LinearLayout>
